model MatchRoster {
  id                   Int               @id @default(autoincrement())
  organizationId       Int               @map("organization_id")
  matchId              Int               @map("match_id")
  matchTeamId          Int               @map("match_team_id")
  tournamentRosterId   Int               @map("tournament_roster_id")
  userId               Int               @map("user_id")
  role                 RosterRole
  jerseyNumberSnapshot Int?              @map("jersey_number_snapshot")
  displayNameSnapshot  String            @map("display_name_snapshot")
  status               MatchRosterStatus @default(AVAILABLE)
  isDeleted            Boolean           @default(false) @map("is_deleted")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  match            Match            @relation("MatchRosters", fields: [matchId], references: [id], onDelete: Restrict)
  matchTeam        MatchTeam        @relation(fields: [matchTeamId], references: [id], onDelete: Restrict)
  tournamentRoster TournamentRoster @relation(fields: [tournamentRosterId], references: [id], onDelete: Restrict)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  mvpOfMatches     Match[]                @relation("MatchMvp")
  playerStatistics PlayerMatchStatistic[]

  // DB-only rule:
  // Partial unique index on match_rosters(match_id, user_id)
  // WHERE is_deleted = false.
  // Must be added manually in migration SQL.
  // First added in migration: sports_module_constraints
  //
  // DB-only rule:
  // Partial unique index on match_rosters(match_id, tournament_roster_id)
  // WHERE is_deleted = false.
  // Must be added manually in migration SQL.
  // First added in migration: sports_module_constraints
  //
  // DB-only rule:
  // Partial index on match_rosters(match_team_id, status)
  // WHERE is_deleted = false.
  // Must be added manually in migration SQL.
  // First added in migration: sports_module_constraints
  //
  @@map("match_rosters")
}
