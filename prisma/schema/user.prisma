model User {
  id            Int          @id @default(autoincrement())
  email         String
  name          String
  birthDate     DateTime     @default(dbgenerated("'1970-01-01'::date")) @map("birth_date") @db.Date
  heightCm      Int?         @map("height_cm")
  passwordHash  String       @map("password_hash")
  status        EntityStatus @default(ACTIVE)
  isDeleted     Boolean      @default(false) @map("is_deleted")
  isSystemAdmin Boolean      @default(false) @map("is_system_admin")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizationAffiliations OrganizationUserAffiliation[]
  userAffiliationsCreated  OrganizationUserAffiliation[] @relation("UserAffiliationCreatedBy")
  teamAffiliationsCreated  OrganizationTeamAffiliation[] @relation("TeamAffiliationCreatedBy")
  refreshTokens            RefreshToken[]

  tournamentsCreated    Tournament[]           @relation("TournamentCreatedBy")
  matchesCreated        Match[]                @relation("MatchCreatedBy")
  tournamentRosters     TournamentRoster[]
  matchRosters          MatchRoster[]
  playerMatchStatistics PlayerMatchStatistic[]

  // DB-only rule:
  // CHECK (email = lower(email)).
  // Must be added manually in migration SQL.
  // First added in migration: initial_db_structure
  //
  // DB-only rule:
  // Partial unique index on users(email)
  // WHERE is_deleted = false AND status <> 'INACTIVE'.
  // Must be added manually in migration SQL.
  // First added in migration: initial_db_structure
  //
  // DB-only check constraint:
  // height_cm IS NULL OR (height_cm >= 50 AND height_cm <= 250).
  // Must be added manually in migration SQL.
  // First added in migration: add_user_profile_fields
  @@map("users")
}
