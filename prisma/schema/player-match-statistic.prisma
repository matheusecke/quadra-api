model PlayerMatchStatistic {
  id                 Int      @id @default(autoincrement())
  organizationId     Int      @map("organization_id")
  matchId            Int      @map("match_id")
  matchTeamId        Int      @map("match_team_id")
  matchRosterId      Int?     @map("match_roster_id")
  tournamentRosterId Int      @map("tournament_roster_id")
  userId             Int      @map("user_id")
  pts                Int?
  fgm                Int?
  fga                Int?
  threeFgm           Int?     @map("three_fgm")
  threeFga           Int?     @map("three_fga")
  ftm                Int?
  fta                Int?
  reb                Int?
  ast                Int?
  stl                Int?
  blk                Int?
  tov                Int?
  pf                 Int?
  minutesSeconds     Int?     @map("minutes_seconds")
  isDeleted          Boolean  @default(false) @map("is_deleted")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  match            Match            @relation(fields: [matchId], references: [id], onDelete: Restrict)
  matchTeam        MatchTeam        @relation(fields: [matchTeamId], references: [id], onDelete: Restrict)
  matchRoster      MatchRoster?     @relation(fields: [matchRosterId], references: [id], onDelete: SetNull)
  tournamentRoster TournamentRoster @relation(fields: [tournamentRosterId], references: [id], onDelete: Restrict)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  // DB-only rule:
