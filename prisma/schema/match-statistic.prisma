model MatchStatistic {
  id        String @id @default(cuid())
  matchId   String
  athleteId String
  teamId    String

  pts      Int @default(0)
  fgm      Int @default(0)
  fga      Int @default(0)
  threeFgm Int @default(0)
  threeFga Int @default(0)
  ftm      Int @default(0)
  fta      Int @default(0)
  reb      Int @default(0)
  ast      Int @default(0)
  stl      Int @default(0)
  blk      Int @default(0)
  tov      Int @default(0)
  pf       Int @default(0)
  min      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match   Match @relation(fields: [matchId], references: [id])
  athlete User  @relation(fields: [athleteId], references: [id])
  team    Team  @relation(fields: [teamId], references: [id])

  @@unique([matchId, athleteId])
}
