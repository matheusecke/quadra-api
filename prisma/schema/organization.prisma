model Organization {
  id        Int          @id @default(autoincrement())
  name      String
  slug      String
  status    EntityStatus @default(ACTIVE)
  isDeleted Boolean      @default(false) @map("is_deleted")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  userAffiliations OrganizationUserAffiliation[]
  teamAffiliations OrganizationTeamAffiliation[]
  refreshTokens    RefreshToken[]

  seasons               Season[]
  tournamentCategories  TournamentCategory[]
  tournaments           Tournament[]
  tournamentTeams       TournamentTeam[]
  tournamentRosters     TournamentRoster[]
  tournamentGroups      TournamentGroup[]
  tournamentGroupTeams  TournamentGroupTeam[]
  bracketRounds         TournamentBracketRound[]
  bracketSlots          TournamentBracketSlot[]
  matches               Match[]
  matchTeams            MatchTeam[]
  matchPeriods          MatchPeriod[]
  matchRosters          MatchRoster[]
  playerMatchStatistics PlayerMatchStatistic[]

  // DB-only rule:
  // CHECK (slug = lower(slug)).
  // Must be added manually in migration SQL.
  // First added in migration: initial_db_structure
  //
  // DB-only rule:
  // Partial unique index on organizations(slug)
  // WHERE is_deleted = false AND status <> 'INACTIVE'.
  // Must be added manually in migration SQL.
  // First added in migration: initial_db_structure
  @@map("organizations")
}
