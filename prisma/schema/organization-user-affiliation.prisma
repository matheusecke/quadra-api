  // DB-only rule:
  // Partial index on organization_user_affiliations(organization_id, role)
  // WHERE is_deleted = false.
  // Must be added manually in migration SQL.
  // First added in migration: initial_db_structure
  //
  // DB-only rule:
  // Partial index on organization_user_affiliations(organization_id, team_id)
  // WHERE is_deleted = false.
  // Must be added manually in migration SQL.
  // First added in migration: initial_db_structure
  //
  // DB-only check constraint:
  // (role = 'ORG_ADMIN' AND team_id IS NULL)
  // OR (role IN ('TEAM_ADMIN', 'ATHLETE', 'COACHING_STAFF') AND team_id IS NOT NULL)
  // First added in migration: initial_db_structure
  //
  // DB-only check constraint:
  // jersey_number IS NULL OR (jersey_number >= 0 AND jersey_number < 100)
  // First added in migration: initial_db_structure
