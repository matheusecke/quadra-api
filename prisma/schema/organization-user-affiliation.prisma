model OrganizationUserAffiliation {
  id              Int                 @id @default(autoincrement())
  userId          Int                 @map("user_id")
  organizationId  Int                 @map("organization_id")
  role            OrgRole
  teamId          Int?                @map("team_id")
  jerseyNumber    Int?                @map("jersey_number")
  position        BasketballPosition?
  status          AffiliationStatus   @default(PENDING) @map("status")
  createdByUserId Int?                @map("created_by_user_id")
  inviteToken     String?             @unique @map("invite_token")
  inviteExpiresAt DateTime?           @map("invite_expires_at") @db.Timestamptz(3)
  isDeleted       Boolean             @default(false) @map("is_deleted")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id])
  createdBy    User?        @relation("UserAffiliationCreatedBy", fields: [createdByUserId], references: [id])

  tournamentRosters TournamentRoster[]

  // DB-only rule:
  // Partial unique index on organization_user_affiliations(user_id, organization_id)
  // WHERE is_deleted = false AND status = 'ACTIVE'.
  // Must be added manually in migration SQL.
  // First added in migration: initial_db_structure
  //
  // DB-only rule:
  // Partial index on organization_user_affiliations(organization_id, role)
  // WHERE is_deleted = false.
  // Must be added manually in migration SQL.
  // First added in migration: initial_db_structure
  //
  // DB-only rule:
  // Partial index on organization_user_affiliations(organization_id, team_id)
  // WHERE is_deleted = false.
  // Must be added manually in migration SQL.
  // First added in migration: initial_db_structure
  //
  // DB-only check constraint:
  // (role = 'ORG_ADMIN' AND team_id IS NULL)
  // OR (role IN ('TEAM_ADMIN', 'ATHLETE', 'COACHING_STAFF') AND team_id IS NOT NULL)
  // First added in migration: initial_db_structure
  //
  // DB-only check constraint:
  // jersey_number IS NULL OR (jersey_number >= 0 AND jersey_number < 100)
  // First added in migration: initial_db_structure
