model Team {
  id        Int          @id @default(autoincrement())
  name      String
  slug      String
  status    EntityStatus @default(ACTIVE)
  isDeleted Boolean      @default(false) @map("is_deleted")
  createdAt DateTime     @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime     @updatedAt @db.Timestamptz(3) @map("updated_at")

  userAffiliations         OrganizationUserAffiliation[]
  organizationAffiliations OrganizationTeamAffiliation[]

