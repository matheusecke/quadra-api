}

enum MatchSide {
  HOME
  AWAY

  @@map("match_side")
}

enum MatchResult {
  WIN
  LOSS

  @@map("match_result")
}

// DEFAULT is a PostgreSQL reserved word, but harmless as a quoted enum label
// and not a reserved word in JavaScript. Verified by prisma:validate and
// prisma:generate before the migration was written.
enum LossType {
  NORMAL
  DEFAULT
  FORFEIT

  @@map("loss_type")
}

enum MatchRosterStatus {
  AVAILABLE
  DNP

  @@map("match_roster_status")
}

enum PeriodType {
  REGULAR
  OVERTIME

  @@map("period_type")
}
