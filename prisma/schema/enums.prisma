  @@map("tournament_status")
}

enum TournamentFormat {
  LEAGUE
  GROUP_STAGE
  KNOCKOUT
  GROUP_STAGE_KNOCKOUT

  @@map("tournament_format")
}

enum TournamentTeamStatus {
  ACTIVE
  WITHDRAWN

  @@map("tournament_team_status")
}

enum RosterStatus {
